{
  "format": "mclib-path-planner",
  "version": 1,
  "name": "Override: take a Pin out of a Cup",
  "description": "Turns the left Toggle red with the Toggle arm, then takes the yellow Pin out of the Cup at (23.5, -23.5) with claw and lift steps and drops it in the red left Goal. That Pin and the one in the neutral left Goal score both yellow halves for red: 40 points.",
  "field": "override",
  "preload": "none",
  "robot": {"preset": "four_motor_450"},
  "start": {"x": 0, "y": -62.7, "heading": 0},
  "steps": [
    {"type": "drive", "note": "swing the Toggle arm back once clear of the wall", "distance": 5, "actions": [{"when": "distance", "value": 2.5, "mechanism": "toggle_arm", "preset": "under_the_axle"}]},
    {"type": "drive", "note": "back the pad into the left Toggle", "distance": -5, "timeout_ms": 1500, "actions": [{"when": "end", "mechanism": "toggle_arm", "preset": "stowed"}]},
    {"type": "drive", "note": "clear the wall before turning", "distance": 4, "actions": [{"when": "start", "mechanism": "lift", "preset": "pin_in_cup"}, {"when": "start", "mechanism": "claw", "preset": "open"}]},
    {"type": "turn", "heading": 33.9},
    {"type": "drive", "note": "jaws around the Pin in Cup 9", "distance": 33.48},
    {"type": "claw", "note": "grip the Pin by its flange", "claw_preset": "closed"},
    {"type": "lift", "note": "lift it clear of the Cup", "lift_preset": "over_center_goal"},
    {"type": "drive", "distance": -3},
    {"type": "turn_to_point", "x": 23.5, "y": -47.1},
    {"type": "drive", "note": "the aligner centres the Pin over the red left Goal", "distance": 6.6, "actions": [{"when": "start", "mechanism": "lift", "preset": "over_alliance_goal"}, {"when": "end", "mechanism": "claw", "preset": "open"}]},
    {"type": "drive", "distance": -8, "actions": [{"when": "distance", "value": 3, "mechanism": "lift", "preset": "down"}]}
  ]
}
